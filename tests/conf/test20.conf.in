user="%USER%";
log-file="%LOGFILE%";
init_d="./init.d";
servers= ({
		hostname = "ouistiti.local";
		service = "www";
		port = 8080;
		keepalivetimeout = 5;
		version="HTTP11";
		vhost = (
		{
			hostname = "myvhost.ouistiti.local";
			auth = {
				type="Basic";
				realm="www.ouistiti.local";
				user="foo";
				passwd="bar";
			};
			document = {
				docroot = "htdocs/vhost";
				dochome = "htdocs/private";
				allow = ".html,.*htm*,.css,.js,.txt,*";
				deny = ".htaccess,.cgi,*.php";
				options = "dirlisting,range,rest";
			};
			redirect = {
				links = ({
					options = "error";
					destination = "error_404.html";
					origin = 404;
				},{
					options = "generate_204";
					origin = "empty";
				});

			};
		},{
			service = "myvhost2";
			document = {
				docroot = "htdocs/";
				allow = ".html,.*htm*,.css,.js,.txt,*";
				deny = ".htaccess,.cgi,*.php";
				options = "dirlisting,range";
			};
		},"./conf/config.d/test20.vhost");
	});


