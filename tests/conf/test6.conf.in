user="%USER%";
log-file="%LOGFILE%";
servers= ({
		hostname = "www.ouistiti.local";
		port = 8080;
		keepalivetimeout = 5;
		version="HTTP11";
		document = {
			docroot = "htdocs";
			allow = ".html,.*htm*,.css,.js,.txt,*";
			deny = ".htaccess,.cgi,*.php";
			options = "dirlisting,range,rest";
			maxsize = 2000;
		};
		websocket = {
			docroot = "/tmp";
			allow = "echo";
			deny = "*";
			denylast = true;
			options = "direct";
		};
	});
