user="%USER%";
log-file="%LOGFILE%";
servers= ({
		hostname = "www.ouistiti.local";
		addr="127.0.0.1";
		port = 8080;
		keepalivetimeout = 5;
		version="HTTP11";
		auth = {
			type="Bearer";
			options = "jwt,cookie,sliding";
			secret = "kXp2s5v8y/B?E(H+KbPeShVmYq3t6w9z";
			issuer = "sqlite";
			realm = "www.ouistiti.local";
			token_ep = "https://auth.ouistiti.local:8080/token";
		};
		document = {
			docroot = "htdocs";
			allow = ".html,.htm,.css,.js,.txt,*";
			deny = ".htaccess,.php";
		};
	});


