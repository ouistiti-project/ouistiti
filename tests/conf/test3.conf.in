user="%USER%";
log-file="%LOGFILE%";
servers= ({
		hostname = "www.ouistiti.local";
		port = 8080;
		keepalivetimeout = 5;
		version="HTTP11";
		cgi = {
			docroot = "htdocs";
			allow = ".cgi*";
			deny = ".htaccess,.php,*.py";
			env = ["FOO=bar"];
		};
		python = {
			docroot = "htdocs";
			allow = ".py*";
			deny = ".htaccess,.php,*.cgi";
			scripts = ["testpython"];
		};
		cors = {
			origin = "localhost";
		};
	});


