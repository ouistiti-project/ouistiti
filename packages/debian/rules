#!/usr/bin/make -f

# Where we install every file before calling dh_install
DESTDIR := $(shell pwd)/debian/tmp
SRCDIR := .

CONFIG_OPTIONS := MJPEG=y WEBCOMMON=y FORWARD=y SIGNATURE=y DIRLISTING_MOD=y \
		  PYTHON=y WEBSTREAM=y AUTHZ_TOTP=y AUTHN_WWFORM=y \
                  DIRLISTING_ADD_CTIME=y prefix=/usr sysconfdir=/etc/ouistiti
MAKE_OPTIONS := LIBHTTPSERVER_NAME=ouistiti

%:
	dh $@

.PHONY: configure
override_dh_auto_configure:
	$(MAKE) -C $(SRCDIR) $(CONFIG_OPTIONS) $(MAKE_OPTIONS) threadpool_defconfig

override_dh_auto_build-arch:
	$(MAKE) -C $(SRCDIR) $(MAKE_OPTIONS)

override_dh_auto_install:
	$(MAKE) -C $(SRCDIR) DESTDIR=$(DESTDIR) $(MAKE_OPTIONS) install
	rm -rf $(DESTDIR)/srv
	chrpath --delete $(DESTDIR)/usr/sbin/*
	chrpath --delete $(DESTDIR)/usr/libexec/ouistiti/*

override_dh_auto_clean:
	$(MAKE) -C $(SRCDIR) distclean

override_dh_auto_test:

override_dh_makeshlibs:

override_dh_shlibdeps:
